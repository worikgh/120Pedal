#N canvas 87 35 547 205 12;
#X text 2 4 Patch to act as four to one channel mixer. The volume for each channel is set using OSC /v/<channel>/<volume>. The volumme must be between 0..1 but is not checked.;
#X obj 226 100 qzn3t_mixer_4_1_internal;
#X obj 393 68 adc~ 4;
#X obj 335 67 adc~ 3;
#X obj 280 67 adc~ 2;
#X obj 225 67 adc~ 1;
#X obj 226 125 dac~ 1;
#X obj 80 67 osc~ 220;
#X msg 96 99 0;
#X msg 137 101 1, f 2;
#X obj 79 126 *~;
#X text 21 74 Send a test signal;
#X connect 1 0 6 0;
#X connect 2 0 1 3;
#X connect 3 0 1 2;
#X connect 4 0 1 1;
#X connect 5 0 1 0;
#X connect 7 0 10 0;
#X connect 8 0 10 1;
#X connect 9 0 10 1;
#X connect 10 0 1 0;
