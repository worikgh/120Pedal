#N canvas 87 35 974 423 12;
#X text 2 4 Patch to act as four to one channel mixer. The volume for each channel is set using OSC /v/<channel>/<volume>. The volumme must be between 0..1 but is not checked.;
#X obj 228 167 qzn3t_mixer_4_1_internal;
#X obj 395 135 adc~ 4;
#X obj 337 134 adc~ 3;
#X obj 282 134 adc~ 2;
#X obj 227 134 adc~ 1;
#X obj 228 192 dac~ 1;
#X obj 91 88 osc~ 220;
#X msg 107 120 0;
#X msg 148 122 1, f 2;
#X obj 90 147 *~;
#X text 17 71 Send a test signal;
#X text 225 91 Channel Volume Control;
#X text 225 108 Only one channel active at a time;
#X connect 1 0 6 0;
#X connect 2 0 1 3;
#X connect 3 0 1 2;
#X connect 4 0 1 1;
#X connect 5 0 1 0;
#X connect 7 0 10 0;
#X connect 8 0 10 1;
#X connect 9 0 10 1;
#X connect 10 0 1 0;
