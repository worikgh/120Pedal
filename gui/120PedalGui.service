## Here's a user systemd service file to start `gui` at login after graphics initialization:


# Here's a user systemd service file to start your GUI application at login after graphics initialization:

# ```ini
[Unit]
Description=120Pedal GUI Application
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/dbus-run-session %h/120Pedal/gui/run.sh
Restart=on-failure
RestartSec=5
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority

[Install]
WantedBy=default.target
# ```

# **Installation:**
# ```bash
# # Create the user service directory
# mkdir -p ~/.config/systemd/user/

# # Copy the service file
# cp 120pedal-gui.service ~/.config/systemd/user/

# # Enable and start the service
# systemctl --user enable 120pedal-gui.service
# systemctl --user start 120pedal-gui.service
# ```

# **Key features:**
# - `After=graphical-session.target` ensures graphics system is ready
# - `Wants=graphical-session.target` creates dependency on graphical session
# - `Environment` variables ensure proper display/X11 access
# - `Restart` policies handle failures gracefully
# - User service runs under your user context after login

# The service will automatically start when you log into a graphical session.


