#!/bin/sh
set -e
echo "DBG examples/mod-ui Start"

# Function to kill a process and wait for it to exit
kill_and_wait() {
    local process_name=$1

    # Check if process exists
    if ! pgrep -x "$process_name" > /dev/null; then
	return 0
    fi

    # Kill the process
    # `sudo`:  This has to kill any of these processes
    sudo pkill -x "$process_name"

    # Wait for process to exit with timeout (50 iterations of 0.1s = 5s)
    local count=0
    while pgrep -x "$process_name" > /dev/null && [ $count -lt 50 ]; do
	sleep 0.1
	count=$((count + 1))
    done

    # Check if process is still running after timeout
    if pgrep -x "$process_name" > /dev/null; then
	echo "Timeout: $process_name did not exit within 5 seconds"
	return 1
    fi

    return 0
}


kill_and_wait "mod-host" || exit 1
kill_and_wait "pd" || exit 1

# # Must sleep here or it will not work.  Frustrating
# sleep 1

sudo systemctl restart modep-mod-ui
echo "DBG examples/mod-ui End"
